generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model profiles {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  email                 String?
  full_name             String?
  first_name            String?
  last_name             String?
  avatar_url            String?
  gender                String?
  expo_push_token       String?
  platform              String?
  subscription_ends_at  DateTime?
  achievement_goal      String?
  date_of_birth         String?
  birth_date            DateTime?
  height                Decimal? @db.Decimal
  height_unit           String?  @default("cm")
  height_value          Decimal? @db.Decimal
  weight                Decimal? @db.Decimal
  weight_unit           String?  @default("kg")
  weight_value          Decimal? @db.Decimal
  target_weight         Decimal? @db.Decimal
  activity_level        Decimal? @db.Decimal
  goal                  String?
  nutrition_goal        String?
  diet_type             String?
  workout_frequency     String?
  subscription_status   String?  @default("free")
  onboarding_completed  Boolean? @default(false)
  coach_style         String?  @default("reto") // apoyo | reto | directo
  onboarding_step       String?  @default("welcome")
  role                  String?  @default("user")
  steps_goal            Int?     @default(10000)
  show_calories         Boolean? @default(true)
  show_hydration        Boolean? @default(true)
  preferred_bottle_size Int?     @default(500)
  preferred_bottle_unit String?  @default("ml")
  timezone              String?
  language              String?  @default("es")
  notifications_enabled Boolean? @default(true)
  dark_mode             Boolean? @default(false)

  @@map("profiles")
}

model meals {
  id             String   @id @default(uuid())
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user_id        String   @map("user_id") @db.Uuid
  meal_at       DateTime @db.Timestamptz(6)
  meal_type      String
  source_type    String?
  status         String?
  llm_model      String?
  image_url      String?
  text_input     String?
  notes          String?
  total_calories Decimal? @default(0) @db.Decimal
  total_protein  Decimal? @default(0) @db.Decimal
  total_carbs    Decimal? @default(0) @db.Decimal
  total_fat      Decimal? @default(0) @db.Decimal
  profilesId     String?  @db.Uuid

  food_items     food_items[]

  @@map("meals")
}

model food_items {
  id                     String   @id @default(uuid())
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  updated_at             DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user_id                String   @db.Uuid
  name                   String
  brand                  String?
  quantity               Decimal? @db.Decimal
  unit                   String?
  calories               Decimal? @db.Decimal
  protein                Decimal? @db.Decimal
  carbs                  Decimal? @db.Decimal
  fat                    Decimal? @db.Decimal
  fiber                  Decimal? @db.Decimal
  sugar                  Decimal? @db.Decimal
  sodium                 Decimal? @db.Decimal
  barcode_number         String?
  scanned                Boolean  @default(false)
  servings               Decimal? @db.Decimal
  contributed            Boolean  @default(false)
  nutriscore_grade       String?
  nova_group             Int?
  notfat_score           Int?
  labels_tags            Json?
  additives_tags         Json?
  notfat_score_breakdown Json?
  additives_details      Json?
  is_alcoholic           Boolean  @default(false)
  has_ingredients_data   Boolean?
  meal_id                String   @map("meal_id")
  profilesId             String?  @db.Uuid

  meals                  meals?   @relation(fields: [meal_id], references: [id])

  @@map("food_items")
}

model recommendation_sessions {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String   @db.Uuid
  meal_type             String?
  available_ingredients String?
  remaining_calories    Decimal? @db.Decimal
  remaining_protein     Decimal? @db.Decimal
  remaining_carbs       Decimal? @db.Decimal
  remaining_fat         Decimal? @db.Decimal
  fridge_image_url      String?
  llm_used              String?
  api_time_ms           Int?
  total_time_ms         Int?
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)
  recipes               recipes[]

  @@map("recommendation_sessions")
}

model recipes {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                   String   @db.Uuid
  name                      String
  description               String?
  instructions              String[]
  prep_time_minutes         Int?
  servings                  Int?
  total_calories            Decimal? @db.Decimal
  total_protein             Decimal? @db.Decimal
  total_carbs               Decimal? @db.Decimal
  total_fat                 Decimal? @db.Decimal
  image_url                 String?
  source_type               String?  @default("ia")
  recommendation_session_id String?  @db.Uuid
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  updated_at                DateTime @updatedAt @db.Timestamptz(6)
  recommendation_sessions   recommendation_sessions? @relation(fields: [recommendation_session_id], references: [id])
  recipe_items              recipe_items[]

  @@map("recipes")
}

model recipe_items {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipe_id  String   @db.Uuid
  name       String
  quantity   Decimal? @db.Decimal
  unit       String?
  calories   Decimal? @db.Decimal
  protein    Decimal? @db.Decimal
  carbs      Decimal? @db.Decimal
  fat        Decimal? @db.Decimal
  created_at DateTime @default(now()) @db.Timestamptz(6)
  recipes    recipes  @relation(fields: [recipe_id], references: [id], onDelete: Cascade)

  @@map("recipe_items")
}

model products {
  id               String   @id @default(uuid())
  barcode          String   @unique
  name             String
  calories         Decimal? @db.Decimal
  protein          Decimal? @db.Decimal
  carbs            Decimal? @db.Decimal
  fat              Decimal? @db.Decimal
  fiber            Decimal? @db.Decimal
  sugar            Decimal? @db.Decimal
  sodium           Decimal? @db.Decimal
  nutriscore_grade String?
  nova_group       Int?
  image_url        String?
  labels_tags      Json?
  additives_tags   Json?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("products")
}

model water_logs {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  user_id          String    @map("user_id") @db.Uuid
  logged_at        DateTime  @default(now()) @db.Timestamptz(6)
  recorded_timezone String?
  volume           Decimal   @db.Decimal
  unit             String
  profilesId       String?   @db.Uuid

  @@map("water_logs")
}

model scan_events {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barcode       String
  origin        String
  result        String?
  product_name  String?
  processing_ms Int?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  completed_at  DateTime? @db.Timestamptz(6)
  user_id       String    @map("user_id") @db.Uuid
  meal_id       String?   @map("meal_id") @db.Uuid

  @@map("scan_events")
}

enum gender_enum {
  male
  female
  non_binary
  other
}

enum user_role {
  user
  creator
  admin
  superadmin
}

enum height_unit_enum {
  cm
  m
  in
}

enum weight_unit_enum {
  kg
  lb
}

enum water_unit_enum {
  ml
  oz
}

enum unit_enum {
  g
  ml
  oz
  cup
  slice
  unit
  tbsp
  tsp
  scoop
  clove
}

enum meal_type_enum {
  breakfast
  lunch
  dinner
  snack
}

enum meal_status {
  analyzing
  complete
  error
  no_nutritional_info
  not_found
  contributed
  pending_lookup
  queued
}

enum meal_source_type_enum {
  camera
  gallery
  text
  scanner
  unknown
  voice
}

enum notification_type {
  simple_reminder
}

enum contribution_status {
  pending
  processing
  completed
  error
}

enum llm_model_enum {
  gemini_2_0_flash @map("gemini-2.0-flash")
  gpt_4_1_mini     @map("gpt-4.1-mini")
  open_food_facts  @map("open-food-facts")
  gemini_2_5_flash @map("gemini-2.5-flash")
  gpt_4_1          @map("gpt-4.1")
  gemini_2_5_pro   @map("gemini-2.5-pro")
}

enum task_type {
  image
  text
  voice
  barcode
}

enum body_fat_unit_enum {
  pct
}

enum nutrition_goal_source {
  algorithm
  ia
  manual
}

model nutrition_goals {
  id          String   @id @default(uuid())
  user_id     String   @db.Uuid
  calories    Int?
  protein     Int?
  carbs       Int?
  fat         Int?
  fiber       Int?
  water       Int?
  is_active   Boolean? @default(true)
  source      String?
  start_date  DateTime @default(now())
  end_date    DateTime?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@map("nutrition_goals")
}

model hydration_goals {
  id          String   @id @default(uuid())
  user_id     String   @db.Uuid
  target      Int?
  target_unit String?
  start_date  DateTime @default(now())
  end_date    DateTime?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@map("hydration_goals")
}

model user_sports {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sport_type    String
  hours_per_week Decimal? @db.Decimal
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
  user_id       String   @db.Uuid

  @@map("user_sports")
}

model health_settings {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  health_platform       String?
  connected_at         DateTime?
  disconnected_at      DateTime?
  eat_back_exercise_calories Boolean @default(true)
  eat_back_neat_calories  Boolean @default(true)
  sync_weight          Boolean  @default(true)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @updatedAt @db.Timestamptz(6)
  user_id             String   @db.Uuid

  @@map("health_settings")
}

model health_daily_snapshots {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date                 DateTime @db.Date
  steps                 Int?
  active_calories_burned  Decimal? @db.Decimal
  workout_calories_burned Decimal? @db.Decimal
  workout_count         Int?
  workout_minutes       Int?
  weight_kg           Decimal? @db.Decimal
  sleep_hours         Decimal? @db.Decimal
  sleep_quality       String?
  synced_at           DateTime @default(now()) @db.Timestamptz(6)
  source              String?
  user_id             String   @db.Uuid

  @@map("health_daily_snapshots")
}

model user_activity_profile {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  does_sport            Boolean?
  daily_activity_level  String?
  activity_system_version String   @default("v2")
  upgraded_to_v2_at    DateTime?
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @updatedAt @db.Timestamptz(6)
  user_id             String   @db.Uuid

  @@map("user_activity_profile")
}

model body_metrics {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  measured_at   DateTime @default(now()) @db.Timestamptz(6)
  weight_value  Decimal? @db.Decimal
  body_fat_value Decimal? @db.Decimal
  height_value  Decimal? @db.Decimal
  weight_unit   String   @default("kg")
  height_unit   String   @default("cm")
  body_fat_unit String   @default("pct")
  user_id       String   @db.Uuid

  @@map("body_metrics")
}

model notification_preferences {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hour            Int
  minute          Int
  meal_type       String?
  enabled         Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)
  is_custom       Boolean  @default(false)
  label           String?
  message         String?
  icon            String?
  predefined_type String?
  user_id         String   @db.Uuid

  @@map("notification_preferences")
}

model notification_logs {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sent_at           DateTime @default(now()) @db.Timestamptz(6)
  notification_type String
  reminder_id        String?
  user_id           String   @db.Uuid

  @@map("notification_logs")
}

model subscriptions {
  id                    String   @id @default(uuid())
  user_id               String?  @db.Uuid
  mercadopago_id         String?
  plan_type             String
  status                String   @default("pending")
  amount                Decimal? @db.Decimal
  currency              String   @default("CLP")
  start_date            DateTime?
  trial_end_date        DateTime?
  end_date              DateTime?
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)
  payment_provider      String   @default("mercadopago")
  provider_subscription_id String?
  revenuecat_id         String?
  environment           String?
  offer_code            String?
  applied_offer_code   String?   @db.VarChar(50)

  @@map("subscriptions")
}

model payments {
  id                    String   @id @default(uuid())
  user_id                String   @db.Uuid
  subscription_id         String?  @db.Uuid
  mercadopago_payment_id String?
  status                String
  status_detail          String?
  payment_type           String?
  amount                Decimal  @db.Decimal
  currency              String
  payment_date          DateTime
  last_modified        DateTime
  payment_data          Json?
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)
  operation_type        String?
  revenuecat_payment_id String?
  environment           String?

  @@map("payments")
}

model payments_analytics {
  id                String   @id @default(uuid())
  event_type         String   @db.VarChar(50)
  is_chilean        Boolean?
  ab_test_group     String?  @db.VarChar(1)
  plan_type         String?  @db.VarChar(20)
  payment_method   String?  @db.VarChar(20)
  transaction_id    String?  @db.VarChar(100)
  amount           Decimal?  @db.Decimal
  currency         String?   @db.VarChar(3)
  is_successful    Boolean?
  error_message    String?
  error_code      String?  @db.VarChar(50)
  platform        String?  @db.VarChar(20)
  app_version     String?  @db.VarChar(20)
  metadata        Json?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  user_id         String   @db.Uuid

  @@map("payments_analytics")
}

model institutions {
  id          String   @id @default(uuid())
  name        String
  logo_url    String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  creator_id  String?

  @@map("institutions")
}

model nutritionists {
  id                String   @id @default(uuid())
  first_name        String?
  last_name         String?
  email             String
  gender            String?
  institution_id    String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  auth_id           String?
  profile_image_url String?
  clicks_ig         Decimal? @db.Decimal
  clicks_wtp        Decimal? @db.Decimal
  instagram_url     String?
  long_description  String?
  phone            String?
  short_description String?
  specialties      String[]
  visible_in_app   Boolean  @default(false)
  profilesId       String?  @db.Uuid
  institutions     institutions? @relation(fields: [institution_id], references: [id])
  nutrition_guidelines nutrition_guidelines[]
  profile_nutritionists profile_nutritionists[]

  @@map("nutritionists")
}

model nutrition_guidelines {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?  @db.Uuid
  nutritionist_id String?  @db.Uuid
  name            String
  status          String   @default("draft")
  allergies       String[]
  pathologies     String[]
  food_aversions  String[]
  cooking_time    String?
  supplementation Boolean? @default(false)
  notes           String?
  source          String?  @default("ia")
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)
  nutritionists   nutritionists? @relation(fields: [nutritionist_id], references: [id])
  guideline_days  guideline_days[]

  @@map("nutrition_guidelines")
}

model guideline_days {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guideline_id    String   @db.Uuid
  day_name        String
  day_order       Int
  context         String?
  total_calories  Decimal? @db.Decimal
  total_protein   Decimal? @db.Decimal
  total_carbs     Decimal? @db.Decimal
  total_fat       Decimal? @db.Decimal
  notes           String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  nutrition_guidelines nutrition_guidelines @relation(fields: [guideline_id], references: [id], onDelete: Cascade)
  guideline_meals      guideline_meals[]

  @@map("guideline_days")
}

model guideline_meals {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guideline_day_id String   @db.Uuid
  meal_order       Int
  meal_type        String
  meal_name        String
  scheduled_time   String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  guideline_days   guideline_days @relation(fields: [guideline_day_id], references: [id], onDelete: Cascade)
  guideline_meal_items guideline_meal_items[]

  @@map("guideline_meals")
}

model guideline_meal_items {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guideline_meal_id String   @db.Uuid
  item_order        Int
  name              String
  quantity          Decimal? @db.Decimal
  unit              String?
  calories          Decimal? @db.Decimal
  protein           Decimal? @db.Decimal
  carbs             Decimal? @db.Decimal
  fat               Decimal? @db.Decimal
  servings          Decimal? @default(1) @db.Decimal
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @updatedAt @db.Timestamptz(6)
  guideline_meals   guideline_meals @relation(fields: [guideline_meal_id], references: [id], onDelete: Cascade)

  @@map("guideline_meal_items")
}

model profile_nutritionists {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id              String   @db.Uuid
  nutritionist_id         String   @db.Uuid
  nutrition_guidelines_id String?  @db.Uuid
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  nutritionists           nutritionists @relation(fields: [nutritionist_id], references: [id], onDelete: Cascade)

  @@map("profile_nutritionists")
}

model additives {
  id              String   @id @default(uuid())
  e_number       String
  name_en        String?
  name_es       String?
  risk_level    String   @default("unknown")
  penalty_points Int     @default(0)
  justification String?
  bibliography  String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
  creator_id    String?

  @@map("additives")
}

model daily_tips {
  id          Int      @id @default(autoincrement())
  emoji       String   @default("💡")
  category    String   @default("nutrición")
  title       String
  description String
  used_at     DateTime? @db.Date
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  profilesId String?  @db.Uuid

  @@map("daily_tips")
}

model coach_messages {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  role       String
  content    String
  metadata   Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("coach_messages")
}
